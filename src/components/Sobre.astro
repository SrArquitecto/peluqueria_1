---
const { nombre, texto } = Astro.props;
---
<section id="sobre" class="scroll-mt-16 bg-neutral/85 py-20 text-neutral-content">
  <div class="mx-auto grid max-w-6xl px-4 gap-8 md:grid-cols-[1fr_2fr] md:gap-12">
    <h2 class="font-display text-4xl font-extrabold tracking-tight md:text-5xl">Sobre {nombre}</h2>
    <p class="max-w-[60ch] text-xl leading-relaxed md:text-2xl">{texto}</p>
  </div>
</section>
