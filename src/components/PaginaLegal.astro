---
import Layout from "../layouts/Layout.astro";
const { titulo, nombre } = Astro.props;
---
<Layout titulo={`${titulo} · ${nombre}`} descripcion={titulo}>
  <header class="mx-auto max-w-3xl px-4 pt-8">
    <a href="/" class="link font-display text-xl font-extrabold no-underline">← {nombre}</a>
  </header>
  <main class="mx-auto max-w-3xl px-4 py-12 [&_h1]:font-display [&_h1]:text-4xl [&_h1]:font-extrabold [&_h2]:mt-10 [&_h2]:font-display [&_h2]:text-xl [&_h2]:font-bold [&_p]:mt-3 [&_ul]:mt-3 [&_ul]:list-disc [&_ul]:pl-6 [&_li]:mt-1 [&_a]:link">
    <h1>{titulo}</h1>
    <slot />
  </main>
</Layout>
