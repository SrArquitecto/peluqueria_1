---
const { nombre, lema, telefono, whatsapp, imagen } = Astro.props;
const tel = telefono.replace(/[^\d+]/g, "");
const wa = whatsapp ? `https://wa.me/${whatsapp.replace(/\D/g, "")}` : "";
const conFoto = Boolean(imagen);
---
<section
  id="inicio"
  class:list={["relative isolate scroll-mt-16 overflow-hidden", conFoto ? "bg-neutral text-neutral-content" : "bg-base-200"]}
>
  {conFoto && (
    <>
      <img src={imagen} alt="" fetchpriority="high" class="absolute inset-y-0 left-0 -z-10 h-full w-full object-cover object-top md:w-auto md:max-w-[60%] md:object-contain md:object-left md:[mask-image:linear-gradient(to_left,transparent,black_45%)]" />
      <div class="absolute inset-0 -z-10 bg-neutral/55 md:hidden"></div>
    </>
  )}
  <div class:list={["mx-auto grid max-w-6xl items-center gap-10 px-4 py-12 md:py-20", conFoto ? "min-h-[60vh]" : "md:grid-cols-[1.25fr_1fr]"]}>
    <div class:list={[conFoto && "md:text-center"]}>
      <h1 class="font-display text-[clamp(3rem,9vw,6.5rem)] font-extrabold leading-[0.95] tracking-tight text-balance">{nombre}</h1>
      <p class:list={["mt-6 max-w-md text-lg", conFoto && "md:mx-auto"]}>{lema}</p>
      <div class:list={["mt-8 flex flex-wrap gap-3", conFoto && "md:justify-center"]}>
        <a href={`tel:${tel}`} class="btn btn-primary btn-lg">Llamar para reservar</a>
        {wa && <a href={wa} target="_blank" rel="noopener" class:list={["btn btn-lg", conFoto ? "glass text-white" : "btn-outline"]}>Escribir por WhatsApp</a>}
      </div>
    </div>
    {!conFoto && (
      <div class="arco mx-auto aspect-[3/4] w-full max-w-sm overflow-hidden rounded-t-full bg-primary">
        <div class="grid h-full place-items-center text-primary-content" aria-hidden="true">
          <span class="font-display text-[10rem] font-extrabold leading-none">{nombre.charAt(0)}</span>
        </div>
      </div>
    )}
  </div>
</section>
