---
const { nombre, lema, telefono, whatsapp } = Astro.props;
const tel = telefono.replace(/[^\d+]/g, "");
const wa = whatsapp ? `https://wa.me/${whatsapp.replace(/\D/g, "")}` : "";
---
<section id="inicio" class="scroll-mt-16 overflow-hidden">
  <div class="mx-auto grid min-h-[60vh] max-w-6xl items-center px-4 py-12 md:py-20">
    <div class="md:text-center">
      <h1 class="font-display text-[clamp(3rem,9vw,6.5rem)] font-extrabold leading-[0.95] tracking-tight text-balance">{nombre}</h1>
      <p class="mt-6 max-w-md text-lg md:mx-auto">{lema}</p>
      <div class="mt-8 flex flex-wrap gap-3 md:justify-center">
        <a href={`tel:${tel}`} class="btn btn-primary btn-lg">Llamar para reservar</a>
        {wa && <a href={wa} target="_blank" rel="noopener" class="btn btn-lg glass text-white">Escribir por WhatsApp</a>}
      </div>
    </div>
  </div>
</section>
