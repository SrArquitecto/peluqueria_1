---
const { nombre, telefono } = Astro.props;
const tel = telefono.replace(/[^\d+]/g, "");
const enlaces = [
  { href: "#servicios", texto: "Servicios" },
  { href: "#sobre", texto: "Sobre nosotros" },
  { href: "#contacto", texto: "Contacto" },
];
---
<header class="sticky top-0 z-30 bg-neutral/85">
  <nav class="navbar mx-auto max-w-6xl px-4" aria-label="Principal">
    <div class="navbar-start">
      <a href="#inicio" class="font-display text-xl font-extrabold tracking-tight">{nombre}</a>
    </div>
    <div class="navbar-end gap-2">
      <a href={`tel:${tel}`} class="btn btn-sm btn-primary">Llamar</a>
      <details class="dropdown dropdown-end" id="menu-movil">
        <summary class="btn btn-ghost btn-square btn-sm list-none" aria-label="Menú">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" /></svg>
        </summary>
        <ul class="menu dropdown-content z-40 mt-2 w-56 rounded-box bg-base-200 p-2 shadow-lg">
          {enlaces.map((e) => (
            <li><a href={e.href}>{e.texto}</a></li>
          ))}
        </ul>
      </details>
    </div>
  </nav>
</header>
<script>
  const menu = document.getElementById("menu-movil");
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => menu.removeAttribute("open")));
</script>
