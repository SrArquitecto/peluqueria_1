---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Servicios from "../components/Servicios.astro";
import Sobre from "../components/Sobre.astro";
import Galeria from "../components/Galeria.astro";
import Opiniones from "../components/Opiniones.astro";
import Contacto from "../components/Contacto.astro";
import Footer from "../components/Footer.astro";
import BarraLlamar from "../components/BarraLlamar.astro";
import { Negocio } from "../data/schema";

export async function getStaticPaths() {
  // Buscamos todos los JSON dentro de src/data/
  const jsonFiles = import.meta.glob('../data/*.json', { eager: true });

  const paths = Object.keys(jsonFiles).map((filePath) => {
    const slug = filePath.split('/').pop().replace('.json', '');
    const fileModule = jsonFiles[filePath];
    
    // Extraemos el objeto JSON (manejando si viene en .default o directo)
    const rawData = fileModule.default || fileModule;

    // Validamos estrictamente con Zod
    const negocio = Negocio.parse(rawData);

    return {
      params: { slug },
      props: { negocio },
    };
  });

  return paths;
}

const { negocio } = Astro.props;

const esquema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: negocio.nombre,
  description: negocio.descripcion,
  telephone: negocio.telefono,
  address: negocio.direccion,
  sameAs: Object.values(negocio.redes ?? {}).filter(Boolean),
};
---
<Layout
  titulo={negocio.nombre}
  descripcion={negocio.descripcion}
  color={negocio.colorPrincipal}
  colorContenido={negocio.colorSobrePrincipal}
  imagen={negocio.imagenPortada}
  imagenDerecha={negocio.imagenPortadaDerecha}
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(esquema)} />
  <Navbar nombre={negocio.nombre} telefono={negocio.telefono} />
  <main>
    <Hero
      nombre={negocio.nombre}
      lema={negocio.lema}
      telefono={negocio.telefono}
      whatsapp={negocio.whatsapp}
    />
    <Servicios categorias={negocio.servicios} />
    <Sobre nombre={negocio.nombre} texto={negocio.sobre} />
    <Galeria fotos={negocio.galeria} antesDespues={negocio.antesDespues} />
    <Opiniones opiniones={negocio.opiniones} />
    <Contacto
      telefono={negocio.telefono}
      whatsapp={negocio.whatsapp}
      email={negocio.email}
      direccion={negocio.direccion}
      mapaUrl={negocio.mapaUrl}
      redes={negocio.redes}
      horario={negocio.horario}
    />
  </main>
  <Footer nombre={negocio.nombre} />
  <BarraLlamar telefono={negocio.telefono} />
</Layout>