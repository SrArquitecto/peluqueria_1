---
import "../styles/global.css";

const { titulo, descripcion, color, colorContenido, imagen, imagenDerecha } = Astro.props;

// El color principal de cada cliente sustituye al del tema sin tocar el diseño.
const estilo = [
  color && `--color-primary: ${color}`,
  colorContenido && `--color-primary-content: ${colorContenido}`,
]
  .filter(Boolean)
  .join("; ");
---
<!doctype html>
<html lang="es" class="scroll-smooth" style={estilo || undefined} data-theme={imagen ? "peluqueria-oscuro" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <slot name="head" />
  </head>
  <body>
    {imagen && (
      <>
        <img src={imagen} alt="" fetchpriority="high" class="pointer-events-none fixed inset-y-0 left-0 -z-10 h-full w-full object-cover object-top md:w-[32%] md:opacity-60 md:object-top md:[mask-image:linear-gradient(to_left,transparent,black_45%)]" />
        {imagenDerecha && (
          <img src={imagenDerecha} alt="" class="pointer-events-none fixed inset-y-0 right-0 -z-10 hidden h-full w-[32%] object-cover object-top opacity-60 md:block [mask-image:linear-gradient(to_right,transparent,black_45%)]" />
        )}
        <div class="pointer-events-none fixed inset-0 -z-10 bg-base-100/60 md:hidden"></div>
      </>
    )}
    <slot />
  </body>
</html>
